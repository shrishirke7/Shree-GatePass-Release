<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#eff4f0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="26dp">

        <ImageView
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_marginTop="28dp"
            android:contentDescription="Shree GatePass Logo"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setup_title"
            android:textColor="#142820"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/setup_subtitle"
            android:textColor="#61746b"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#ffffff"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GatePass Server Web URL"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/serverUrlInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:hint="https://192.168.130.31:8859"
                android:inputType="textUri"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="#0f172a"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Examples:\n• https://192.168.130.31:8859 (HTTPS LAN)\n• http://192.168.130.31:8858 (Fast LAN HTTP)\n• https://192.168.130.31:8859/portal (Gate Kiosk Mode)\n• http://gatepass.local:8858 (LAN Domain)"
                android:textColor="#61746b"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/bgAlertsCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:text="Enable background Visitor &amp; Material alerts"
                android:textColor="#142820"
                android:textSize="13sp" />

            <Button
                android:id="@+id/connectServerBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#157a54"
                android:text="Connect &amp; Open Shree GatePass →"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
